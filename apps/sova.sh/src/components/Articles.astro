---
export interface Article {
  title: string;
  url: string;
  description: string;
  cover: string | null;
  emoji?: string;
  published_at: string;
}

export interface Props {
  articles: Article[];
}

const {articles} = Astro.props;
---

<ul class="content-grid">
  {
    articles.map((article) => (
      <li class="article">
        <a href={article.url} rel="noopener">
          <div
            class:list={['cover', {empty: !article.cover}]}
            style={article.cover ? `background-image: url(${article.cover})` : ''}
          />
          <span class="title">{article.title}</span>
          <p class="description">{article.description}</p>
        </a>
      </li>
    ))
  }
</ul>

<style>
  @reference '../styles/global.css';

  @media (max-width: 559px) {
    .article:nth-child(n + 4) {
      display: none;
    }
  }

  .article {
    @apply flex flex-col gap-1 overflow-hidden border border-zinc-700 bg-zinc-950;
  }

  .article:hover {
    border-color: var(--color-accent);
  }

  .article .cover {
    @apply block bg-cover bg-center;
    aspect-ratio: 2.5;
  }

  .article .cover.empty {
    background-color: var(--color-line);
    background-image: none;
  }

  .article .title {
    @apply block px-4 py-2 text-2xl font-light text-zinc-100;
  }

  .article .description {
    @apply px-4 py-3 text-lg text-zinc-300;
  }
</style>
