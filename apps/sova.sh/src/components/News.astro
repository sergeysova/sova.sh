---
import type {NewsIssue} from '../data/news';

export interface Props {
  news: NewsIssue[];
}

const issues = Astro.props.news;
---

<ul class="content-grid">
  {
    issues.map((issue) => (
      <li class="issue" style={`background-image: url(${issue.image})`}>
        <a href={issue.url} rel="noopener">
          <span class="number">#{issue.id}</span>
          <p class="description">{issue.description}</p>
        </a>
      </li>
    ))
  }
</ul>

<style>
  @reference '../styles/global.css';

  @media (max-width: 559px) {
    .issue:nth-child(n + 4) {
      display: none;
    }
  }

  @media (min-width: 400px) {
    .issue {
      min-height: 20ch;
    }
  }

  .issue {
    @apply flex flex-col gap-1 overflow-hidden border border-zinc-700 bg-zinc-950 bg-cover bg-center;
  }

  .issue a {
    @apply h-full overflow-hidden bg-zinc-950/90 text-zinc-100;
  }

  .issue:hover a {
    color: var(--color-text);
    background-color: rgb(10 10 11 / 90%);
  }

  .issue .number {
    @apply float-right overflow-hidden px-4 py-2 text-3xl font-light;
  }

  .issue .description {
    @apply px-4 py-3 text-lg;
  }
</style>
