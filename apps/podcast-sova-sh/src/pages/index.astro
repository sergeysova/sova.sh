---
import Layout from '../layouts/Layout.astro';
import {getAllEpisodes} from '../data/episodes';

const episodes = await getAllEpisodes();
---

<Layout title="Под куполом — подкаст Сергея Совы">
  <main class="mx-auto flex max-w-[65ch] flex-col gap-6 px-6 pb-16">
    <h1 class="text-4xl font-bold">Под куполом</h1>
    <p class="text-lg text-slate-700">
      Нерегулярные выпуски подкаста — записи размышлений об устройстве мира, личных переживаний и
      открытии нового в формате ночных посиделок.
    </p>

    <ul class="flex flex-col gap-6">
      {
        episodes.map((episode) => (
          <li class="flex gap-4 border-b border-slate-200 pb-6">
            <img src={episode.imageURL} alt="" width="96" height="96" class="h-24 w-24 rounded-md object-cover" />
            <div class="flex flex-col gap-1">
              <a href={`/episodes/${episode.slug}/`} class="text-xl font-semibold hover:underline">
                {episode.title}
              </a>
              <p class="text-sm text-slate-500">
                Сезон {episode.season}, выпуск {episode.number}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
