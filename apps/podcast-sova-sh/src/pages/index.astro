---
import Layout from '../layouts/Layout.astro';
import {getAllEpisodes} from '../data/episodes';

const episodes = await getAllEpisodes();
---

<Layout title="Под куполом — подкаст Сергея Совы">
  <main id="main-content" class="site-container podcast-main">
    <section class="podcast-hero site-hero">
      <h1>Под куполом</h1>
      <p>
        Нерегулярные выпуски подкаста — записи размышлений об устройстве мира, личных переживаний и
        открытии нового в формате ночных посиделок.
      </p>
      <nav class="podcast-links" aria-label="Подписка на подкаст">
        <a href="https://feeds.simplecast.com/sZjtmMOM">RSS-лента</a>
      </nav>
    </section>

    <section aria-label="Все выпуски">
      <ul class="episode-list">
        {
          episodes.map((episode) => (
            <li class="episode-card">
              <a href={`/episodes/${episode.slug}/`}>
                <img src={episode.imageURL} alt="" width="120" height="120" loading="lazy" />
                <div class="episode-card-copy">
                  <span class="meta">
                    Сезон {episode.season}, выпуск {episode.number}
                  </span>
                  <h2>{episode.title}</h2>
                  <time class="meta" datetime={episode.publishedAt}>
                    {new Date(episode.publishedAt).toLocaleDateString('ru-RU', {
                      dateStyle: 'medium',
                    })}
                  </time>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>
