---
import "../styles/global.css";

import { SEO, type Meta } from "astro-seo";
import SiteHeader from "@sova-web/ui/SiteHeader.astro";
import SiteFooter from "@sova-web/ui/SiteFooter.astro";
import ThemeHead from "@sova-web/ui/ThemeHead.astro";
export interface Props {
  title: string;
  description: string;
  slug: string;
  image?: string;
  publishedDate?: Date;
}

const { title, description, slug, image, publishedDate } = Astro.props;
---

<!doctype html>
<html lang="ru" prefix="og: https://ogp.me/ns#">
  <head>
    <link rel="icon" href="/favicon.png" />
    <ThemeHead />
    <SEO
      charset="UTF-8"
      title={title}
      description={description}
      canonical={Astro.url.toString()}
      twitter={{
        card: image ? "summary_large_image" : "summary",
        creator: "@sova_original",
        site: "@sova_original",
        image,
        title,
        description,
      }}
      openGraph={{
        basic: {
          title: title,
          type: slug === "/" ? "website" : "article",
          image: image ?? "/banner.jpg",
          url: Astro.url?.toString(),
        },
        image: {
          alt: title,
        },
        article: {
          publishedTime: publishedDate?.toISOString(),
        },
        optional: { description: `${description} ` },
      }}
      extend={{
        link: [
          {
            rel: "alternate",
            type: "application/rss+xml",
            title: "Сова рассылает новости",
            href: "/rss.xml",
          },
        ],
        meta: [
          image
            ? {
                name: "image",
                content: image,
              }
            : null,
          {
            name: "color-scheme",
            content: "dark",
          },
          {
            name: "viewport",
            content: "width=device-width,initial-scale=1,viewport-fit=cover",
          },
        ].filter(Boolean) as Meta[],
      }}
    />
  </head>
  <body>
    <SiteHeader site="news" locale="ru" />
    <slot />
    <SiteFooter locale="ru" />
  </body>
</html>
